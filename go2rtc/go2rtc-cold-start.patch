diff --git a/pkg/xiaomi/miss/producer_cold_test.go b/pkg/xiaomi/miss/producer_cold_test.go
new file mode 100644
index 0000000..ecc95de
--- /dev/null
+++ b/pkg/xiaomi/miss/producer_cold_test.go
@@ -0,0 +1,27 @@
+package miss
+
+import (
+	"encoding/binary"
+	"testing"
+)
+
+func accessUnit(nalus ...[]byte) []byte {
+	var result []byte
+	for _, nalu := range nalus {
+		result = binary.BigEndian.AppendUint32(result, uint32(len(nalu)))
+		result = append(result, nalu...)
+	}
+	return result
+}
+
+func TestInitialParameterSetsAfterPrefix(t *testing.T) {
+	if !containsNALU(accessUnit([]byte{35 << 1, 1}, []byte{32 << 1, 1}), 32, true) {
+		t.Fatal("HEVC VPS after AUD must be recognized in the first access unit")
+	}
+	if !containsNALU(accessUnit([]byte{9, 1}, []byte{7, 1}), 7, false) {
+		t.Fatal("H264 SPS after AUD must be recognized in the first access unit")
+	}
+	if containsNALU([]byte{0, 0, 2, 0, 64}, 32, true) {
+		t.Fatal("truncated parameter set must not be accepted")
+	}
+}
diff --git a/pkg/xiaomi/miss/cs2/cold_handshake_test.go b/pkg/xiaomi/miss/cs2/cold_handshake_test.go
new file mode 100644
index 0000000..cfa581c
--- /dev/null
+++ b/pkg/xiaomi/miss/cs2/cold_handshake_test.go
@@ -0,0 +1,53 @@
+package cs2
+
+import (
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// A camera may become ready after initial discovery packets are lost. Recovery
+// should be prompt while connecting, and stop sending when discovery finishes.
+func TestColdDiscoveryRecoversLossAndStops(t *testing.T) {
+	peer, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer peer.Close()
+	local, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer local.Close()
+	c := &udpConn{UDPConn: local, addr: peer.LocalAddr().(*net.UDPAddr)}
+	_ = c.SetDeadline(time.Now().Add(2 * time.Second))
+	var received atomic.Int32
+	go func() {
+		buf := make([]byte, 64)
+		for {
+			_, addr, err := peer.ReadFromUDP(buf)
+			if err != nil {
+				return
+			}
+			if received.Add(1) == 2 {
+				reply := make([]byte, 16)
+				reply[0], reply[1] = magic, msgPunchPkt
+				_, _ = peer.WriteToUDP(reply, addr)
+			}
+		}
+	}()
+	start := time.Now()
+	_, err = c.WriteUntil([]byte{magic, msgLanSearch, 0, 0}, func(b []byte) bool { return b[1] == msgPunchPkt })
+	if err != nil {
+		t.Fatal(err)
+	}
+	if elapsed := time.Since(start); elapsed > 1500*time.Millisecond {
+		t.Fatalf("slow discovery: %v", elapsed)
+	}
+	before := received.Load()
+	time.Sleep(250 * time.Millisecond)
+	if received.Load() != before {
+		t.Fatal("discovery kept sending after completion")
+	}
+}
diff --git a/pkg/xiaomi/miss/cs2/command_ack_test.go b/pkg/xiaomi/miss/cs2/command_ack_test.go
new file mode 100644
index 0000000..59d3b1f
--- /dev/null
+++ b/pkg/xiaomi/miss/cs2/command_ack_test.go
@@ -0,0 +1,42 @@
+package cs2
+
+import (
+	"net"
+	"testing"
+	"time"
+)
+
+func TestCommandResponseAndAckLifecycle(t *testing.T) {
+	for _, command := range []uint32{0x100, 0x1001} {
+		left, right := net.Pipe()
+		c := &Conn{Conn: left}
+		go func() {
+			buf := make([]byte, 256)
+			_, _ = right.Read(buf)
+			c.signalCmdAck(true)
+			if command != 0x100 {
+				time.Sleep(30 * time.Millisecond)
+				c.signalCmdAck(false)
+			}
+		}()
+		start := time.Now()
+		if err := c.WriteCommand(command, []byte("request")); err != nil {
+			t.Fatal(err)
+		}
+		elapsed := time.Since(start)
+		if elapsed > 500*time.Millisecond {
+			t.Fatalf("ACK was delayed: %v", elapsed)
+		}
+		if command != 0x100 && elapsed < 20*time.Millisecond {
+			t.Fatal("unrelated auth response acknowledged another command")
+		}
+		c.signalCmdAck(false) // A late ACK must have no live callback/timer.
+		c.ackMu.Lock()
+		if c.cmdAck != nil {
+			t.Error("ACK callback retained after command")
+		}
+		c.ackMu.Unlock()
+		_ = left.Close()
+		_ = right.Close()
+	}
+}
