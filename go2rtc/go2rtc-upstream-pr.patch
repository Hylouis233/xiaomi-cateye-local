+
+func (p *parameterSets) absorb(buf []byte, hevc bool) {
+	p.hevc = hevc
+	for len(buf) >= 5 {
+		size := int(binary.BigEndian.Uint32(buf))
+		if size < 1 || size > len(buf)-4 {
+			return
+		}
+		typ := buf[4] & 0x1F
+		if hevc {
+			typ = buf[4] >> 1 & 0x3F
+		}
+		keep := false
+		switch {
+		case hevc && typ == h265.NALUTypeVPS:
+			p.vps = true
+			keep = true
+		case hevc && typ == h265.NALUTypeSPS:
