+			keep = true
+		case !hevc && typ == h264.NALUTypeSPS:
+			p.sps = true
+			keep = true
+		case !hevc && typ == h264.NALUTypePPS:
+			p.pps = true
+			keep = true
+		}
+		if keep {
+			p.avcc = append(p.avcc, buf[:4+size]...)
+		}
+		buf = buf[4+size:]
+	}
+}
