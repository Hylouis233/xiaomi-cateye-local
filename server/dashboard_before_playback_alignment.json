        {
          "type": "vertical-stack",
          "cards": [
            {
              "type": "custom:nvr-low-latency-card",
              "streams": [
                {
                  "title": "流畅",
                  "stream": "ezviz_bb8083087_live_fast"
                },
                {
                  "title": "高清",
                  "stream": "ezviz_bb8083087_live_main"
                }
              ]
            },
            {
              "type": "custom:cateye-expand-card",
              "face_entity": "sensor.mao_yan_zui_jin_shi_bie_ren_lian",
              "media_card": {
                "type": "custom:advanced-camera-card",
                "cameras": [
                  {
                    "camera_entity": "camera.cateye",
                    "id": "cateye",
                    "title": "猫眼录像",
                    "frigate": {
                      "camera_name": "cateye"
                    }
                  }
                ],
                "view": {
                  "default": "recordings"
                },
                "live": {
                  "preload": false,
                  "lazy_load": true,
                  "lazy_unload": [
                    "hidden",
                    "unselected"
                  ]
                },
                "menu": {
                  "style": "outside",
                  "buttons": {
                    "live": {
                      "enabled": false
                    },
                    "microphone": {
                      "enabled": false
                    },
                    "camera_ui": {
                      "enabled": false
                    }
                  }
                },
                "performance": {
                  "features": {
                    "media_chunk_size": 12,
                    "max_simultaneous_engine_requests": 4
                  }
                },
                "media_viewer": {
                  "lazy_load": true,
                  "transition_effect": "none"
                }
              }
            }
          ]
        },
